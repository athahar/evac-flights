PORT=3210
AUTO_START=false
SCAN_INTERVAL_MINUTES=2

DUFFEL_TOKEN=duffel_test_xxx
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
DUFFEL_RATE_LIMIT_PER_MINUTE=50
DUFFEL_RATE_WINDOW_MS=60000
DUFFEL_LOGS=true
DUFFEL_LOG_PAYLOADS=false

RESEND_API_KEY=re_xxx
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com

ORIGIN_AIRPORTS=DXB,AUH,SHJ
DESTINATIONS_FILE=./config/destinations.txt
BLOCKLIST_FILE=./config/blocked_middle_east.json
FR24_INPUT_FILE=./data/input/fr24-march-05
AIRLINE_WEBSITES_FILE=./data/input/airlines.json
DB_PATH=./data/output/state.db

# Storage backend: "sqlite" (default, local) or "supabase" (remote Postgres)
STORAGE_BACKEND=sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

PAX_ADULTS=1
MAX_CONNECTIONS=1
DEFAULT_CABIN_CLASS=economy
LOOKAHEAD_DAYS=1

DASHBOARD_AUTO_START=false
DASHBOARD_INTERVAL_MINUTES=30
DASHBOARD_LOOKAHEAD_DAYS=2
DASHBOARD_RUN_DELAY_MS=1200
DASHBOARD_TIMEZONE=Asia/Dubai
DASHBOARD_EXCLUDE_TEST_AIRLINE=true

POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
