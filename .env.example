PORT=3210
AUTO_START=false
SCAN_INTERVAL_MINUTES=2

DUFFEL_TOKEN=duffel_test_xxx
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
DUFFEL_RATE_LIMIT_PER_MINUTE=50
DUFFEL_RATE_WINDOW_MS=60000
DUFFEL_LOGS=true
DUFFEL_LOG_PAYLOADS=false

RESEND_API_KEY=re_xxx
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com

ORIGIN_AIRPORTS=DXB,AUH,SHJ
DESTINATIONS_FILE=./config/destinations.txt
BLOCKLIST_FILE=./config/blocked_middle_east.json
FR24_INPUT_FILE=./data/input/fr24-march-05

# Optional: enable FlightRadar API as live source (falls back to file by default)
FR24_API_ENABLED=false
FR24_API_KEY=
# If unset and FR24_API_USE_DEFAULT_TEMPLATE=true, uses:
# https://fr24api.flightradar24.com/api/flight-summary/light?airports={AIRPORT}&type=outbound&flight_datetime_from={DATE}T00:00:00&flight_datetime_to={DATE}T23:59:59
FR24_API_URL_TEMPLATE=
FR24_API_USE_DEFAULT_TEMPLATE=true
FR24_API_AUTH_HEADER=Authorization
FR24_API_AUTH_PREFIX=Bearer
FR24_API_ACCEPT_VERSION=v1
FR24_API_RESPONSE_PATH=data
FR24_API_TIMEOUT_MS=15000
FR24_API_MAX_ATTEMPTS=3
FR24_API_BACKOFF_MS=1200
# Keep <= your plan's per-minute request cap (Explorer screenshot shows 10/min)
FR24_API_RATE_LIMIT_PER_MINUTE=10
# Budget rule of thumb: rateLimitPerMinute >= maxAttempts x numEndpointCallsPerRun
FR24_API_INTER_REQUEST_DELAY_MS=0
# Post-normalization coverage validation guards
FR24_API_MIN_STATUS_COVERAGE=0.8
FR24_API_MIN_FLIGHT_COVERAGE=0.7
FR24_API_MIN_DESTINATION_COVERAGE=0.95
FR24_API_MIN_DEPARTURE_COVERAGE=0.95
FR24_API_FALLBACK_TO_FILE=true

AIRLINE_WEBSITES_FILE=./data/input/airlines.json
DB_PATH=./data/output/state.db

# Storage backend: "sqlite" (default, local) or "supabase" (remote Postgres)
STORAGE_BACKEND=sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

PAX_ADULTS=1
MAX_CONNECTIONS=1
DEFAULT_CABIN_CLASS=economy
LOOKAHEAD_DAYS=1

DASHBOARD_AUTO_START=false
DASHBOARD_INTERVAL_MINUTES=30
DASHBOARD_LOOKAHEAD_DAYS=2
DASHBOARD_RUN_DELAY_MS=1200
DASHBOARD_TIMEZONE=Asia/Dubai
DASHBOARD_EXCLUDE_TEST_AIRLINE=true

POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
